@page "/"
@attribute [Authorize]
@using WorkshopAdmin.UI.Components.Dashboard
@using WorkshopAdmin.Shared.Dtos.Dashboard
@using WorkshopAdmin.UI.Services
@inject DashboardClient DashboardClient

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #000666;">
                Workshop Dashboard
            </MudText>

            <MudText Typo="Typo.body2" Class="text-secondary">
                System overview for technical operations.
            </MudText>
        </div>

       

    </div>

    <MudGrid Class="mb-4">

        <!-- ACTIVE ORDERS -->
        <MudItem xs="12" sm="6" md="3">

            <KpiCard Title="Active Orders"
                     Value="@Stats.ActiveOrders.ToString()"
                     SubText="@($"{Stats.PendingApprovals} pending approvals")"
                     Icon="@Icons.Material.Filled.PendingActions"
                     IconColor="Color.Primary"
                     IconBackground="rgba(76, 86, 175, 0.10)"
                     BadgeText="@($"{Stats.ActiveOrdersGrowthPercentage}%")"
                     BadgeColor="Color.Success"
                     ShowProgress="true"
                     ProgressValue="68"
                     ProgressColor="Color.Primary" />

        </MudItem>

        <!-- LOW STOCK -->
        <MudItem xs="12" sm="6" md="3">

            <KpiCard Title="Low Stock"
                     Value="@Stats.LowStockParts.ToString()"
                     SubText="@($"{Stats.CriticalPartName} critically low")"
                     Icon="@Icons.Material.Filled.Warning"
                     IconColor="Color.Error"
                     IconBackground="rgba(186, 26, 26, 0.12)"
                     BadgeText="Action Required"
                     BadgeColor="Color.Error"
                     HighlightBorder="true"
                     HighlightColor="var(--mud-palette-error)" />

        </MudItem>

        <!-- DAILY REVENUE -->
        <MudItem xs="12" sm="6" md="3">

            <KpiCard Title="Daily Revenue"
                     Value="@Stats.DailyRevenue.ToString("C")"
                     SubText="@($"Avg ticket: {Stats.AverageTicket:C}")"
                     Icon="@Icons.Material.Filled.Payments"
                     IconColor="Color.Success"
                     IconBackground="rgba(16, 185, 129, 0.10)"
                     BadgeText="@($"{Stats.DailyRevenueGrowthPercentage}%")"
                     BadgeColor="Color.Success" />

        </MudItem>

        <!-- CUSTOMER SAT -->
        <MudItem xs="12" sm="6" md="3">

            <KpiCard Title="Customer Satisfaction"
                     Value="4.9"
                     SubText="142 reviews"
                     Icon="@Icons.Material.Filled.Star"
                     IconColor="Color.Warning"
                     IconBackground="rgba(245, 158, 11, 0.12)"
                     BadgeText="Excellent"
                     BadgeColor="Color.Warning" />

        </MudItem>

    </MudGrid>
    <MudGrid>

        <MudItem xs="12" lg="8">

            <ServiceVolumeChart  />

        </MudItem>
        <MudItem xs="12" lg="4">

            <LowStockPartsPanel />
        </MudItem>
    </MudGrid>
    <TableOverview />
</MudContainer>
@code {
    private DashboardStatsDto Stats = new();

    protected override async Task OnInitializedAsync()
    {
        Stats = await DashboardClient.GetStatsAsync();
    }
}
