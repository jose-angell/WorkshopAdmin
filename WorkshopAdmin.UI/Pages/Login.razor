@page "/login"
@using WorkshopAdmin.Shared.Dtos.Auth
@using WorkshopAdmin.UI.Services
@inject AuthClient authClient
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ILoginService loginService
@inject ISnackbar Snackbar


<link href="css/background.css" rel="stylesheet" />

<div class="register-background">
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-10">
        <MudPaper Class="pa-6 rounded-lg" Elevation="25">
            <MudText Typo="Typo.h4" Class="text-center mb-6">Iniciar Sesión</MudText>

            <MudTextField @bind-Value="login.Email" Label="Correo Electrónico" Variant="Variant.Outlined"
            FullWidth="true" Margin="Margin.Dense" Required="true"
            HelperText="Por favor, ingresa tu correo electrónico." />

            <MudTextField @bind-Value="login.Password" Label="Contraseña" Variant="Variant.Outlined"
            FullWidth="true" Margin="Margin.Dense" InputType="@PasswordInput"
            Required="true" HelperText="Por favor, ingresa tu contraseña."
            Class="mt-4" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon"
            OnAdornmentClick="ButtonTestclick" AdornmentAriaLabel="Show Password" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6 w-100"
            OnClick="HandleLogin">Iniciar Sesión</MudButton>

            
            <MudText Class="text-center mt-4">
                ¿Olvidaste tu contraseña? <MudLink Href="/resetPassword" Color="Color.Primary">Recuperala aquí</MudLink>
            </MudText>
        </MudPaper>
    </MudContainer>
</div>

@code {
    private readonly LoginRequest login = new();
    private bool isShow;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private async Task HandleLogin()
    {
        // El AuthClient usa el DTO LoginRequest que definimos [12], [1]
        var result = await authClient.LoginAsync(login);

        if (result != null && result.IsLoggedIn)
        {
            // El loginService (AuthenticationProviderJWT) procesa los claims [13], [5]
            await loginService.Login(result.Token);
            Snackbar.Add($"Bienvenido al sistema.", Severity.Success);
            Navigation.NavigateTo("/");
        }
        else
        {
            // Manejo de errores basado en tu estrategia de respuestas [3], [14]
            Snackbar.Add("Correo electrónico o contraseña incorrectos.", Severity.Error);
        }
    }

    private void ButtonTestclick()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }
}