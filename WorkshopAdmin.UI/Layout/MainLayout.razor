@inherits LayoutComponentBase
@inject NavigationManager Navigation
<MudPopoverProvider />
<MudThemeProvider Theme="Theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        @* Caso 1: Usuario Autenticado (Admin o Técnico) *@
        <Authorized>
            @if (!Navigation.Uri.Contains("/login"))
            {
                @* Sidebar (Drawer) visible solo si está logueado *@
                <MudDrawer @bind-Open="_drawerOpen"
                Elevation="0"
                ClipMode="DrawerClipMode.Never"
                Variant="@DrawerVariant.Responsive"
                Width="260px"
                Class="bg-slate-50 border-r border-slate-200">
                    <SideNav />
                </MudDrawer>

                @* Barra superior con el nombre del usuario y logout *@
                <TopBar DrawerToggleCallback="DrawerToggle" />
                @* Contenido principal con el espaciado para el Sidebar *@
                <MudMainContent Class="bg-slate-50">
                    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-16 px-8 min-h-screen">
                        @Body
                    </MudContainer>
                </MudMainContent>
            }
            else
            {
                <h3>Loading...</h3>
            }
        </Authorized>

        @* Caso 2: Usuario Anónimo (Pantalla de Login) *@
        <NotAuthorized>
            <MudMainContent>
                @* Renderiza solo el Body (Login.razor) sin SideNav ni TopBar *@
                <div class="d-flex align-center justify-center min-h-screen">
                    @Body
                </div>
            </MudMainContent>
        </NotAuthorized>
    </AuthorizeView>
</MudLayout>

@code {
    public static MudTheme Theme => new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#000666",             // El Azul Profundo de Stitch
            Secondary = "#4c616c",
            Tertiary = "#380b00",
            Background = "#f9f9f9",
            AppbarBackground = "#ffffff",    // TopBar en blanco
            Surface = "#ffffff",
            DrawerBackground = "#eeeeee",
            Error = "#ba1a1a",
            TextPrimary = "#1a1c1c",
            LinesDefault = "#767683",
            Success = "#2e7d32",
            Warning = "#ed6c02",
            Divider = "#e2e8f0"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "4px"
        }
    };
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}