@using System.Globalization
@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.ServiceOrders
@using WorkshopAdmin.Shared.Enums
@using WorkshopAdmin.UI.Services
@inject ISnackbar Snackbar
@inject ServiceOrderClient OrderClient
@inject NavigationManager Navigation
@inject IDialogService DialogService



<MudPaper Elevation="1"
          Class="rounded-4 border overflow-hidden">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom">

        <div>
            <MudText Typo="Typo.h6" Class="fw-bold">
                Operations Overview
            </MudText>

            <MudText Typo="Typo.caption"
                     Color="Color.Secondary">

                Recent service orders requiring attention

            </MudText>
        </div>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="GoToOrders"
                   EndIcon="@Icons.Material.Filled.ArrowForward">

            View All

        </MudButton>

    </div>

    <!-- TABLE -->
    <MudTable Items="@Orders"
              Dense="true"
              Loading="@_loading"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              RowsPerPage="5"
              Class="dashboard-overview-table">

        <HeaderContent>

            <MudTh>Order</MudTh>

            <MudTh>Customer</MudTh>

            <MudTh>Equipment</MudTh>

            <MudTh>Status</MudTh>

            <MudTh>Progress</MudTh>

            <MudTh>ETA</MudTh>

            <MudTh Align="Align.Right">Total</MudTh>

            <MudTh Align="Align.Center">Actions</MudTh>

        </HeaderContent>

        <RowTemplate>

            <!-- ORDER -->
            <MudTd>

                <MudStack Spacing="0">

                    <MudText Typo="Typo.body2"
                             Class="fw-bold"
                             Style="font-family: monospace; color: var(--mud-palette-primary);">

                        @context.FriendlyId

                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">

                        @context.CreatedAt.ToLocalTime().ToString("dd/MM/yy hh:mm tt")

                    </MudText>

                </MudStack>

            </MudTd>

            <!-- CUSTOMER -->
            <MudTd>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">

                    <div>

                        <MudText Typo="Typo.body2"
                                 Class="fw-semibold">

                            @context.Customer.Name

                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            @context.Customer.Email
                            (@context.Customer.Phone)

                        </MudText>

                    </div>

                </MudStack>

            </MudTd>

            <!-- Equipment -->
            <MudTd>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">

                    

                    <div>

                        <MudText Typo="Typo.body2"
                                 Class="fw-semibold">

                            @context.Equipment.DescriptionType

                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            @context.Equipment.Brand
                            @context.Equipment.Model

                        </MudText>

                    </div>

                </MudStack>

            </MudTd>

            <!-- STATUS -->
            <MudTd>

                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="@GetStatusColor(context.Status)"
                         Class="fw-bold text-uppercase">

                    @context.Status.ToFriendlyName()

                </MudChip>

            </MudTd>

            <!-- PROGRESS -->
            <MudTd Style="min-width: 100px;">

                <MudStack Spacing="1">

                    <MudProgressLinear Value="@GetProgress(context.Status)"
                                       Rounded="true"
                                       Height="8"
                                       Color="@GetProgressColor(context.Status)" />

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">

                        @GetProgress(context.Status)%

                    </MudText>

                </MudStack>

            </MudTd>

            <!-- ETA -->
            <MudTd>

                @if (context.IsDelayed)
                {
                    <MudChip T="string"
                             Color="Color.Error"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             StartIcon="@Icons.Material.Filled.Warning">

                        Delayed

                    </MudChip>
                }
                else
                {
                    <MudStack Spacing="0">

                        <MudText Typo="Typo.body2">

                            @context.RemainingBusinessTimeDisplay

                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            ETA:
                            @context.ExpectedFinishDisplay

                        </MudText>

                    </MudStack>
                }

            </MudTd>

            <!-- TOTAL -->
            <MudTd Align="Align.Right">

                <MudText Class="fw-bold"
                         Style="font-family: monospace;">

                    @context.TotalCost.ToString("C", new CultureInfo("en-US"))

                </MudText>

            </MudTd>

            <!-- ACTIONS -->
            <MudTd Align="Align.Center">

                <MudTooltip Text="View Details">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => OpenViewDialog(context))"
                                   Size="Size.Small"
                                   Color="Color.Primary" />

                </MudTooltip>

            </MudTd>

        </RowTemplate>

        <!-- PAGINATION -->
        <PagerContent>

            <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />

        </PagerContent>

    </MudTable>
</MudPaper>

@code {

    private List<ServiceOrderDto> Orders = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData(ServiceOrderStatus? filterStatus = null, Guid? filterCustomer = null)
    {
        try
        {
            _loading = true;
            // Ahora pasamos los filtros al servicio
            Orders = await OrderClient.GetAllAsync(filterStatus, filterCustomer);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al sincronizar con el servidor", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
    // =========================================
    // HELPERS
    // =========================================

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(" ", StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private Color GetStatusColor(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Diagnosing => Color.Warning,
            ServiceOrderStatus.Received => Color.Info,
            ServiceOrderStatus.Repairing => Color.Primary,
            ServiceOrderStatus.Cancelled => Color.Error,
            ServiceOrderStatus.Completed => Color.Success,
            ServiceOrderStatus.Delivered => Color.Secondary,
            _ => Color.Default
        };
    }

    private Color GetProgressColor(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Diagnosing => Color.Warning,
            ServiceOrderStatus.Received => Color.Info,
            ServiceOrderStatus.Repairing => Color.Primary,
            ServiceOrderStatus.Cancelled => Color.Error,
            ServiceOrderStatus.Completed => Color.Success,
            ServiceOrderStatus.Delivered => Color.Secondary,
            _ => Color.Default
        };
    }

    private double GetProgress(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Received => 15,
            ServiceOrderStatus.Diagnosing => 40,
            ServiceOrderStatus.Repairing => 60,
            ServiceOrderStatus.Completed => 80,
            ServiceOrderStatus.Delivered => 100,
            ServiceOrderStatus.Cancelled => 0,
            _ => 0
        };
    }
    private void GoToOrders()
    {
        Navigation.NavigateTo("/orders");
    }
    private async Task OpenViewDialog(ServiceOrderDto order)
    {
        var IdOrder = order.Id;

        var parameters = new DialogParameters<OrderDetail>
        {
            { x => x.OrderId, IdOrder }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false // Evita que se cierre por error al dar click fuera
        };

        var dialog = await DialogService.ShowAsync<OrderDetail>(" ", parameters, options);
        var result = await dialog.Result;
    }
}