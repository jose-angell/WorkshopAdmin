@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.Dashboard
@using WorkshopAdmin.UI.Services

@inject DashboardClient DashboardClient

<MudPaper Elevation="1"
          Class="pa-6 rounded-xl border h-100">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6">

        <MudStack Spacing="0">

            <MudText Typo="Typo.h6"
                     Class="fw-bold">
                Service Volume Trend
            </MudText>

            <MudText Typo="Typo.caption"
                     Class="text-secondary">
                Weekly intake vs completed orders
            </MudText>

        </MudStack>

        <MudChip T="string"
                 Color="Color.Primary"
                 Variant="Variant.Filled"
                 Size="Size.Small"
                 Class="fw-bold">
            LIVE
        </MudChip>

    </MudStack>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true"
                             Color="Color.Primary" />
    }
    else
    {
        <MudChart ChartType="ChartType.Bar"
                  ChartSeries="@_series"
                  ChartLabels="@_xAxisLabels"
                  Width="100%"
                  Height="320px"
                  ChartOptions="@_chartOptions"
                  LegendPosition="Position.Bottom" />
    }

</MudPaper>

@code {

    private bool _loading = true;

    private readonly BarChartOptions _chartOptions = new()
    {
        BarWidthRatio = 0.95,
        YAxisTicks = 2,
        MaxNumYAxisTicks = 4
    };

    private List<ChartSeries<double>> _series = [];

    private string[] _xAxisLabels = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;

        try
        {
            var stats =
                await DashboardClient.GetServiceVolumeTrendAsync();

            _xAxisLabels =
                stats.Points
                    .Select(x => x.Label)
                    .ToArray();

            _series =
            [
                new ChartSeries<double>()
                {
                    Name = "Intake",
                    Data = stats.Points
                        .Select(x => (double)x.Intake)
                        .ToArray()
                },

                new ChartSeries<double>()
                {
                    Name = "Completed",
                    Data = stats.Points
                        .Select(x => (double)x.Completed)
                        .ToArray()
                }
            ];
        }
        finally
        {
            _loading = false;
        }
    }

}