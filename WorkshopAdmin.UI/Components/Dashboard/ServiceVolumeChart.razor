@using MudBlazor

<MudPaper Elevation="1"
          Class="pa-6 rounded-xl border h-100">

    <!-- HEADER -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Class="mb-6">

        <MudStack Spacing="0">

            <MudText Typo="Typo.h6"
                     Class="fw-bold">
                Service Volume Trend
            </MudText>

            <MudText Typo="Typo.caption"
                     Class="text-secondary">
                Weekly intake vs completed orders
            </MudText>

        </MudStack>

        <MudChip T="string"
                 Color="Color.Primary"
                 Variant="Variant.Filled"
                 Size="Size.Small"
                 Class="fw-bold">
            LIVE
        </MudChip>

    </MudStack>

    <!-- CHART -->
    <MudChart ChartType="ChartType.Bar"
              ChartSeries="@_series"
              ChartLabels="@_xAxisLabels"
              Width="100%"
              Height="320px"
              ChartOptions="@_chartOptions"
              LegendPosition="Position.Bottom" />

</MudPaper>

<style>

    /* Contenedor general */
    .mud-paper {
        background: white;
    }

    /* Grid lines suaves */
    .mud-chart-grid line {
        stroke: #f1f5f9 !important;
        stroke-width: 1 !important;
    }

    /* Texto eje X */
    .mud-chart-axis text {
        fill: #94a3b8 !important;
        font-size: 10px !important;
        font-weight: 700 !important;
        text-transform: uppercase;
    }

    /* Remover líneas oscuras de ejes */
    .mud-chart-axis path,
    .mud-chart-axis line {
        stroke: transparent !important;
    }

    /* Leyenda */
    .mud-chart-legend text {
        fill: #64748b !important;
        font-size: 12px !important;
        font-weight: 600;
    }

</style>

@code {

    private readonly BarChartOptions _chartOptions = new()
    {
        BarWidthRatio = 0.95,
        YAxisTicks = 2,
        //YAxisRequireZeroPoint = true,
        MaxNumYAxisTicks = 4
    };

    private readonly List<ChartSeries<double>> _series =
    [
        new ChartSeries<double>()
        {
            Name = "Intake",
             Data = new double[]
            {
                18, 24, 16, 30, 20, 10, 5
            }
        },

        new ChartSeries<double>()
        {
            Name = "Completed",
            Data = new double[]
            {
                12, 18, 10, 25, 15, 5, 2
            }
        }
    ];

    private readonly string[] _xAxisLabels =
    [
        "Mon",
        "Tue",
        "Wed",
        "Thu",
        "Fri",
        "Sat",
        "Sun"
    ];

}