@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.Customers
@using WorkshopAdmin.Shared.Dtos.Equipments
@using WorkshopAdmin.Shared.Dtos.ServiceOrders
@using WorkshopAdmin.Shared.Enums

<MudPaper Elevation="1"
          Class="rounded-4 border overflow-hidden">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom">

        <div>
            <MudText Typo="Typo.h6" Class="fw-bold">
                Operations Overview
            </MudText>

            <MudText Typo="Typo.caption"
                     Color="Color.Secondary">

                Recent service orders requiring attention

            </MudText>
        </div>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward">

            View All

        </MudButton>

    </div>

    <!-- TABLE -->
    <MudTable Items="@Orders"
              Dense="true"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              Class="dashboard-overview-table">

        <HeaderContent>

            <MudTh>Order</MudTh>

            <MudTh>Customer</MudTh>

            <MudTh>Status</MudTh>

            <MudTh>Progress</MudTh>

            <MudTh>ETA</MudTh>

            <MudTh Align="Align.Right">Total</MudTh>

            <MudTh Align="Align.Center">Actions</MudTh>

        </HeaderContent>

        <RowTemplate>

            <!-- ORDER -->
            <MudTd>

                <MudStack Spacing="0">

                    <MudText Typo="Typo.body2"
                             Class="fw-bold"
                             Style="font-family: monospace; color: var(--mud-palette-primary);">

                        @context.FriendlyId

                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">

                        @context.CreatedAt.ToLocalTime().ToString("dd MMM - hh:mm tt")

                    </MudText>

                </MudStack>

            </MudTd>

            <!-- CUSTOMER -->
            <MudTd>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">

                    <MudAvatar Size="Size.Medium"
                               Color="Color.Primary">

                        @GetInitials(context.Customer.Name)

                    </MudAvatar>

                    <div>

                        <MudText Typo="Typo.body2"
                                 Class="fw-semibold">

                            @context.Customer.Name

                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            @context.Equipment.Brand
                            @context.Equipment.Model

                        </MudText>

                    </div>

                </MudStack>

            </MudTd>

            <!-- STATUS -->
            <MudTd>

                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Color="@GetStatusColor(context.Status)"
                         Class="fw-bold text-uppercase">

                    @context.Status.ToFriendlyName()

                </MudChip>

            </MudTd>

            <!-- PROGRESS -->
            <MudTd Style="min-width: 140px;">

                <MudStack Spacing="1">

                    <MudProgressLinear Value="@GetProgress(context.Status)"
                                       Rounded="true"
                                       Height="8"
                                       Color="@GetProgressColor(context.Status)" />

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">

                        @GetProgress(context.Status)%

                    </MudText>

                </MudStack>

            </MudTd>

            <!-- ETA -->
            <MudTd>

                @if (context.IsDelayed)
                {
                    <MudChip T="string"
                             Color="Color.Error"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             StartIcon="@Icons.Material.Filled.Warning">

                        Delayed

                    </MudChip>
                }
                else
                {
                    <MudStack Spacing="0">

                        <MudText Typo="Typo.body2">

                            @context.RemainingBusinessTimeDisplay

                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">

                            ETA:
                            @context.ExpectedFinishDisplay

                        </MudText>

                    </MudStack>
                }

            </MudTd>

            <!-- TOTAL -->
            <MudTd Align="Align.Right">

                <MudText Class="fw-bold"
                         Style="font-family: monospace;">

                    @context.TotalCost.ToString("C")

                </MudText>

            </MudTd>

            <!-- ACTIONS -->
            <MudTd Align="Align.Center">

                <MudTooltip Text="View Details">

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   Color="Color.Primary" />

                </MudTooltip>

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>

