    // =========================================
    // HELPERS
    // =========================================

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(" ", StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[1][0]}".ToUpper();
    }

    private Color GetStatusColor(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Diagnosing => Color.Warning,
            ServiceOrderStatus.Received => Color.Info,
            ServiceOrderStatus.Repairing => Color.Primary,
            ServiceOrderStatus.Cancelled => Color.Error,
            ServiceOrderStatus.Completed => Color.Success,
            ServiceOrderStatus.Delivered => Color.Secondary,
            _ => Color.Default
        };
    }

    private Color GetProgressColor(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Diagnosing => Color.Warning,
            ServiceOrderStatus.Received => Color.Info,
            ServiceOrderStatus.Repairing => Color.Primary,
            ServiceOrderStatus.Cancelled => Color.Error,
            ServiceOrderStatus.Completed => Color.Success,
            ServiceOrderStatus.Delivered => Color.Secondary,
            _ => Color.Default
        };
    }

    private double GetProgress(ServiceOrderStatus status)
    {
        return status switch
        {
            ServiceOrderStatus.Received => 15,
            ServiceOrderStatus.Diagnosing => 40,
            ServiceOrderStatus.Repairing => 60,
            ServiceOrderStatus.Completed => 80,
            ServiceOrderStatus.Delivered => 100,
            ServiceOrderStatus.Cancelled => 0,
            _ => 0
        };
    }

