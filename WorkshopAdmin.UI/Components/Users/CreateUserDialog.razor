@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.Customers
@using WorkshopAdmin.Shared.Dtos.Users
@using WorkshopAdmin.Shared.Emuns
@using WorkshopAdmin.UI.Services
@inject ISnackbar Snackbar
@inject UserClient UserClient

<MudDialog Class="custom-industrial-dialog">
    <TitleContent>
        <div class="d-flex align-items-center gap-3 py-2 px-1">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="color: white;" />
            <MudText Typo="Typo.h6" Class="fw-bold text-white text-uppercase">
                Add New User
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="4" Class="mt-2">

                <!-- NAME -->
                <MudTextField T="string"
                              Label="FULL NAME *"
                              @bind-Value="_model.FullName"
                              Required="true"
                              RequiredError="The name is mandatory for the audit trail."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Badge" />

                <MudGrid Spacing="2">


                    <!-- PHONE -->
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="PHONE NUMBER"
                                      @bind-Value="_model.Phone"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Phone" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="UserRole"
                                   Label="Role *"
                                   @bind-Value="_model.Role"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var role in Enum.GetValues<UserRole>())

                            {
                                <MudSelectItem Value="@role">
                                    @role.ToFriendlyName()
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <!-- EMAIL -->
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="EMAIL ADDRESS"
                                      @bind-Value="_model.Email"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                    </MudItem>
                    <!-- Password -->
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="PASSWORD"
                                      @bind-Value="_model.Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Password" />
                    </MudItem>

                </MudGrid>
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <div class="px-4 pb-4 d-flex gap-2 w-100 justify-content-end">

            <MudButton OnClick="Cancel"
                       Variant="Variant.Text"
                       Class="px-4">
                Cancel
            </MudButton>

            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!_isValid)"
                       Class="px-4 fw-bold shadow-none">
                Save User
            </MudButton>

        </div>
    </DialogActions>
</MudDialog>

@code {
    // CORRECCIÓN: Usar IMudDialogInstance con la 'I'
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // Modelo solicitado
    private CreateUserRequest _model = new();
    private MudForm _form = default!;
    private bool _isValid;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (_isValid)
        {

            var result = await UserClient.CreateAsync(_model);

            if (result != null)
            {
                MudDialog.Close(DialogResult.Ok(result));
            }
            else
            {
                Snackbar.Add("Could not save customer. Please check the data.", Severity.Error);
            }
        }
    }
}