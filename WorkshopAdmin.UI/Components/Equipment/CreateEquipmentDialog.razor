@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.Customers
@using WorkshopAdmin.Shared.Dtos.Equipments
@using WorkshopAdmin.Shared.Enums
@using WorkshopAdmin.UI.Services
@inject ISnackbar Snackbar
@inject EquipmentClient EquipmentClient
@inject CustomerClient CustomerClient

<MudDialog Class="custom-industrial-dialog">

    <!-- HEADER -->
    <TitleContent>
        <div class="d-flex align-items-center gap-3 py-2 px-1">
            <MudIcon Icon="@Icons.Material.Filled.Handyman" Style="color: white;" />
            <MudText Typo="Typo.h6" Class="fw-bold text-white text-uppercase">
                Add New Equipment
            </MudText>
        </div>
    </TitleContent>

    <!-- CONTENT -->
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">

            <MudStack Spacing="4" Class="mt-2">
                <MudAutocomplete T="CustomerDto"
                                 Value="_selectedCustomer"
                                 ValueChanged="OnCustomerChanged"
                                 SearchFunc="SearchCustomers"
                                 ToStringFunc="@(c => c is null ? string.Empty : $"{c.Name} ({c.Phone})")"
                                 Variant="Variant.Outlined"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 Placeholder="Search by name, ID or phone..."
                                 Class="w-100"
                                 Required="true"
                                 Disabled="@(Customer != null)" />
                <MudGrid Spacing="2">

                    <MudItem xs="12" sm="6">
                        <MudSelect T="EquipmentType"
                                   Label="CATEGORY "
                                   @bind-Value="_model.TypeId"
                                   Required="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var equipment in Enum.GetValues<EquipmentType>())
                            {
                                <MudSelectItem Value="@equipment">
                                    @equipment.ToFriendlyName()
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Description "
                                      @bind-Value="_model.DescriptionType"
                                      Required="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Brand "
                                      @bind-Value="_model.Brand"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.BrandingWatermark" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Model "
                                      @bind-Value="_model.Model"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.ModelTraining" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Label="Technical Specifications"
                                      @bind-Value="_model.TechnicalSpecifications"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Engineering"
                                      TextArea="true"
                                      Lines="5"
                                      AutoGrow="true" />
                    </MudItem>

                </MudGrid>

            </MudStack>

        </MudForm>
    </DialogContent>

    <!-- FOOTER -->
    <DialogActions>
        <div class="px-4 pb-4 d-flex gap-2 w-100 justify-content-end">

            <MudButton OnClick="Cancel"
                       Variant="Variant.Text"
                       Class="px-3">
                Cancel
            </MudButton>

            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(!_isValid)"
                       Class="px-4 fw-bold shadow-none"
                       StartIcon="@Icons.Material.Filled.Save">
                Save Equipment
            </MudButton>

        </div>
    </DialogActions>

</MudDialog>
@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public CustomerDto? Customer { get; set; }

    private CreateEquipmentRequest _model = new();
    private MudForm _form = default!;
    private bool _isValid;

    private CustomerDto? _selectedCustomer;


    protected override void OnInitialized()
    {
        if (Customer != null)
        {
            _selectedCustomer = Customer;
            _model.CustomerId = Customer.Id;
        }
    }

    private async Task OnCustomerChanged(CustomerDto? value)
    {
        _selectedCustomer = value;

        _model.CustomerId = value?.Id ?? Guid.Empty;
    }
    private async Task<IEnumerable<CustomerDto>> SearchCustomers(string value, CancellationToken token)
    {
        var data = await CustomerClient.GetAllAsync();

        var result = data
            .Where(x => string.IsNullOrWhiteSpace(value)
                    || x.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
                    || x.Phone.Contains(value, StringComparison.OrdinalIgnoreCase)
                    || x.FriendlyId.Contains(value, StringComparison.OrdinalIgnoreCase));

        return result;
    }
    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (_isValid)
        {
            
            var result = await EquipmentClient.CreateAsync(_model);
        
            if (result != null)
            {
                MudDialog.Close(DialogResult.Ok(result));
            }
            else
            {
                Snackbar.Add("Could not save equipment. Please check the data.", Severity.Error);
            }
        }
    }

  
}