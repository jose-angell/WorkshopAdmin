@using MudBlazor
@using WorkshopAdmin.Shared.Dtos.Equipments
@using WorkshopAdmin.Shared.Enums
@using WorkshopAdmin.UI.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject EquipmentClient EquipmentClient


    <MudDataGrid T="EquipmentDto"
                 Items="_equipment"
                 Loading="_loading"
                 Dense="true"
                 Hover="true"
                 Bordered="false"
                 Striped="false"
                 Elevation="0">

        <Columns>

            <PropertyColumn Property="x => x.Id" Title="ID">
                <CellTemplate>
                    <MudText Typo="Typo.caption" Class="font-mono text-slate-400" Style="font-size: 13px;">
                        #@context.Item.FriendlyId
                    </MudText>
                </CellTemplate>
            </PropertyColumn>

            <!-- TYPE & DESCRIPTION -->
            <TemplateColumn Title="TYPE & DESCRIPTION">
                <CellTemplate>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">
                            @context.Item.TypeName
                        </MudText>

                        <MudText Typo="Typo.caption" Class="text-secondary">
                            @context.Item.DescriptionType
                        </MudText>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <!-- BRAND -->
            <PropertyColumn Property="x => x.Brand" Title="BRAND" />

            <!-- MODEL -->
            <PropertyColumn Property="x => x.Model" Title="MODEL" />

            <!-- TECHNICAL SPECIFICATIONS -->
            <TemplateColumn Title="TECHNICAL SPECIFICATIONS">
                <CellTemplate>
                    <MudPaper Class="p-2 rounded bg-light">
                        <MudText Typo="Typo.caption">
                            @context.Item.TechnicalSpecifications
                        </MudText>
                    </MudPaper>
                </CellTemplate>
            </TemplateColumn>

            <!-- STATUS -->
            <TemplateColumn Title="STATUS" Align="Align.Center">
                <CellTemplate>
                    <MudChip Size="Size.Small"
                             Variant="Variant.Filled"
                             Color="@GetStatusColor(context.Item)">
                        @GetStatusText(context.Item)
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>

            <!-- ACTIONS -->
            <TemplateColumn Title="ACTIONS" Align="Align.Right">
                <CellTemplate>
                    <div class="d-flex justify-content-end gap-1">

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(context.Item))" />

                        <MudIconButton Icon="@Icons.Material.Filled.History"
                                       Size="Size.Small"
                                       OnClick="@(() => OnHistory.InvokeAsync(context.Item))" />

                        @* <MudIconButton Icon="@Icons.Material.Filled.Settings"
                                       Size="Size.Small"
                                       OnClick ="@(() => OnManage.InvokeAsync(context.Item))" />*@

                    </div>
                </CellTemplate>
            </TemplateColumn>

        </Columns>

        <!-- EMPTY -->
        <NoRecordsContent>
            <MudText Class="p-4">No equipment found</MudText>
        </NoRecordsContent>

    <PagerContent>
        <MudDataGridPager T="EquipmentDto" />
    </PagerContent>

    </MudDataGrid>



@code {
    [Parameter] public bool ReloadTrigger { get; set; }
    public List<EquipmentDto> _equipment  = new();
    private bool _loading = true;
    private bool _lastReloadTrigger;

    [Parameter] public EventCallback<EquipmentDto> OnEdit { get; set; }
    [Parameter] public EventCallback<EquipmentDto> OnHistory { get; set; }
    [Parameter] public EventCallback<EquipmentDto> OnManage { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadDataEquipment();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_lastReloadTrigger != ReloadTrigger)
        {
            _lastReloadTrigger = ReloadTrigger;
            await LoadDataEquipment();
        }
    }
    private async Task LoadDataEquipment()
    {
        try
        {
            _loading = true;
           
            _equipment = await EquipmentClient.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error al sincronizar con el servidor", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
   

    private Color GetStatusColor(EquipmentDto item)
    {
        if (!item.IsActive)
            return Color.Error;

        return Color.Success;
    }

    private string GetStatusText(EquipmentDto item)
    {
        if (!item.IsActive)
            return "Decommissioned";

        return "Active";
    }
    private async Task OpenEditDialog(EquipmentDto equipment)
    {
        // 1. Mapeamos el DTO al modelo de edición
        var updateRequest = new UpdateEquipmentRequest
        {
            Id = equipment.Id,
            CustomerInfo = equipment.CustomerName + " (" + equipment.CustomerFriendlyId + ")",
            TypeId = equipment.TypeId,
            DescriptionType = equipment.DescriptionType,
            Model = equipment.Model,
            Brand = equipment.Brand,
            TechnicalSpecifications = equipment.TechnicalSpecifications,
            IsActive = equipment.IsActive
        };

        var parameters = new DialogParameters<EditEquipmentDialog>
        {
            { x => x.InitialData, updateRequest }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false 
        };

        var dialog = await DialogService.ShowAsync<EditEquipmentDialog>(" ", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Equipo actualizado correctamente", Severity.Success);
            await LoadDataEquipment(); 
        }
    }
}