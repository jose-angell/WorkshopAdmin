@using WorkshopAdmin.Shared.Enums
@using WorkshopAdmin.Shared.Filters
@* Components/Equipment/EquipmentFilters.razor *@
<MudPaper Elevation="0" Class="p-4 rounded-4 border bg-white mb-4">

    <MudGrid Spacing="3" Class="align-items-center">

        <!-- SEARCH -->
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string"
                          Value="@Filters.Search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Search Equipment..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="bg-light w-100" />
        </MudItem>

        <!-- STATUS -->
        <MudItem xs="12" sm="3" md="2">
            <MudSelect T="bool?"
                       Value="@Filters.IsActive"
                       ValueChanged="OnStatusChanged"
                       Label="Status"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="bg-light w-100">

                <MudSelectItem Value="@((bool?)null)">
                    All
                </MudSelectItem>

                <MudSelectItem Value="@((bool?)true)">
                    Active
                </MudSelectItem>

                <MudSelectItem Value="@((bool?)false)">
                    Inactive
                </MudSelectItem>

            </MudSelect>
        </MudItem>

        <!-- BUTTON -->
        <MudItem xs="12" sm="3" md="2">
            <MudSelect T="PartCategory?"
                       Label="CATEGORY"
                       Value="@Filters.Category"
                       ValueChanged="OnCategoryChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">

                <MudSelectItem Value="@((PartCategory?)null)">
                    All Categories
                </MudSelectItem>

                @foreach (var equipment in Enum.GetValues<PartCategory>())
                {
                    <MudSelectItem Value="@((PartCategory?)equipment)">
                        @equipment.ToFriendlyName()
                    </MudSelectItem>
                }

            </MudSelect>
        </MudItem>

    </MudGrid>

</MudPaper>

                       
@code {

    [Parameter]
    public PartFilterModel Filters { get; set; } = new();

    [Parameter]
    public EventCallback<PartFilterModel> FiltersChanged { get; set; }

    private async Task OnSearchChanged(string value)
    {
        Filters.Search = value;

        await FiltersChanged.InvokeAsync(Filters);
    }

    private async Task OnStatusChanged(bool? value)
    {
        Filters.IsActive = value;

        await FiltersChanged.InvokeAsync(Filters);
    }

    private async Task OnCategoryChanged(PartCategory? value)
    {
        Filters.Category = value;

        await FiltersChanged.InvokeAsync(Filters);
    }
}