@using WorkshopAdmin.Shared.Enums
@using WorkshopAdmin.Shared.Filters
@* Components/Equipment/EquipmentFilters.razor *@
<MudPaper Elevation="0" Class="p-4 rounded-4 border bg-white mb-4">

    <MudGrid Spacing="3" Class="align-items-center">

        <!-- SEARCH -->
        <MudItem xs="12" sm="6" md="4">
            <MudTextField T="string"
                          Value="@Filters.Search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="Search Equipment..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="bg-light w-100" />
        </MudItem>

       

        <!-- BUTTON -->
        <MudItem xs="12" sm="3" md="2">
            <MudSelect T="ServiceOrderStatus?"
                       Label="ORDER STATUS"
                       Value="@Filters.orderStatus"
                       ValueChanged="OnOrderStatusChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">

                <MudSelectItem Value="@((ServiceOrderStatus?)null)">
                    All Statuses
                </MudSelectItem>

                @foreach (var status in Enum.GetValues<ServiceOrderStatus>())
                {
                    <MudSelectItem Value="@((ServiceOrderStatus?)status)">
                        @status.ToFriendlyName()
                    </MudSelectItem>
                }

            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3" md="2">
            <MudSelect T="ServiceType?"
                       Label="Service Type"
                       Value="@Filters.serviceType"
                       ValueChanged="OnServiceTypeChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">

                <MudSelectItem Value="@((ServiceType?)null)">
                    All Types
                </MudSelectItem>

                @foreach (var type in Enum.GetValues<ServiceType>())
                {
                    <MudSelectItem Value="@((ServiceType?)type)">
                        @type.ToFriendlyName()
                    </MudSelectItem>
                }

            </MudSelect>
        </MudItem>
    </MudGrid>

</MudPaper>

                       
@code {

    [Parameter]
    public ServiceOrderFilterModel Filters { get; set; } = new();

    [Parameter]
    public EventCallback<ServiceOrderFilterModel> FiltersChanged { get; set; }

    private async Task OnSearchChanged(string value)
    {
        Filters.Search = value;

        await FiltersChanged.InvokeAsync(Filters);
    }


    private async Task OnOrderStatusChanged(ServiceOrderStatus? value)
    {
        Filters.orderStatus = value;

        await FiltersChanged.InvokeAsync(Filters);
    }
    private async Task OnServiceTypeChanged(ServiceType? value)
    {
        Filters.serviceType = value;

        await FiltersChanged.InvokeAsync(Filters);
    }
}